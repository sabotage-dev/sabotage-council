{
  "name": "sabotage-council",
  "version": "0.1.0",
  "description": "A three-seat review council for code and plans.",
  "license": "MIT",
  "author": "Sabotage Development LLC",
  "homepage": "https://github.com/sabotage-dev/sabotage-council#readme",
  "bugs": {
    "url": "https://github.com/sabotage-dev/sabotage-council/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabotage-dev/sabotage-council.git"
  },
  "keywords": [
    "code-review",
    "review",
    "council",
    "pull-request",
    "plan-review",
    "claude-code",
    "codex",
    "ai-agents",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "sabotage-council": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "fixtures/planted",
    "plugin/ADJUDICATE.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run test/live.test.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
