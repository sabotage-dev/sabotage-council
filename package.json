{
  "name": "sabotage-council",
  "version": "0.0.0",
  "private": true,
  "description": "A three-seat review council for code and plans.",
  "license": "MIT",
  "author": "Sabotage Development LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabotage-dev/sabotage-council.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "sabotage-council": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
